[Unit]
Description=NodeSpark Wisp
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_ROOT__
Environment=HOME=__APP_HOME__
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_ROOT__/.venv/bin/nodespark-wisp --config /etc/nodespark-wisp/config.toml daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
